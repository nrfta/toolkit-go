  """
  Performs a case-insensitive substring match.
  """
  contains: String

  """
  Performs a case-insensitive substring exclusion match.
  """
  notContains: String

  """
  If true, checks if the string is null. If false, matches any non-null values.
  """
  null: Boolean
}

# Represents a date and time in ISO 8601 format.
# Also accepts ISO 8601 durations strings which are added to the current
# date to create the represented date (e.g '-P2W1D' represents the date that was
# two weeks and 1 day ago)
scalar DateTimeOrDuration

"""
DateComparator is used to filter results based on date/datetime values.

Supports two input formats:
1. Absolute dates:
   - DateTime (RFC3339): "2025-01-01T00:00:00Z" for timestamp columns
   - Date-only: "2025-01-01" for date columns
2. Relative durations (ISO 8601):
   - Future: "P2W" (2 weeks from now), "P30D" (30 days)
   - Past: "-P1M" (1 month ago), "-P2W" (2 weeks ago)

Column type handling:
- Date columns: Use date-only format or let database truncate datetime
- Timestamp columns: Use RFC3339 format; date-only interpreted as midnight
"""
input DateComparator
  @goModel(model: "github.com/nrfta/toolkit-go/comparators.Date") {
  """
  Checks if the date equals the provided value.
  Accepts RFC3339, date-only, or ISO 8601 duration (e.g., "P2W", "-P1M").
  """
  eq: DateTimeOrDuration

  """
  Checks if the date does not equal the provided value.
  """
  neq: DateTimeOrDuration

  """
  Checks if the date is within the provided list of values.
  """
  in: [DateTimeOrDuration!]

  """
  Checks if the date is not within the provided list of values.
  """
  nin: [DateTimeOrDuration!]

  """
  Checks if the date is less than the provided value (before).
  """
  lt: DateTimeOrDuration

  """
  Checks if the date is less than or equal to the provided value.
  """
  lte: DateTimeOrDuration

  """
  Checks if the date is greater than the provided value (after).
  """
  gt: DateTimeOrDuration

  """
  Checks if the date is greater than or equal to the provided value.
  """
  gte: DateTimeOrDuration
}

"""
NullableDateComparator extends DateComparator with null value filtering.
"""
input NullableDateComparator
  @goModel(model: "github.com/nrfta/toolkit-go/comparators.NullableDate") {
  eq: String
  neq: String
  in: [String!]
  nin: [String!]
  lt: String
  lte: String
  gt: String
  gte: String

  """
  If true, matches null values. If false, matches only non-null values.
  """
  null: Boolean
}
